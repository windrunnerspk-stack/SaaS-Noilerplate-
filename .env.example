# =============================================================================
# SAAS BOILERPLATE PREMIUM - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Renombra este archivo a .env.local para tu entorno de desarrollo.

# URL Pública de la Aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de Datos Relacional (PostgreSQL / Supabase / Neon / PlanetScale)
# Ejemplo Supabase/PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/saas_db?schema=public"

# Autenticación (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
# Genera una clave secreta segura ejecutando: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-y-seguro"

# Proveedores de Autenticación OAuth (Opcional - Google & GitHub)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Proveedor de Correo para Enlaces Mágicos (Postmark / Resend / Nodemailer)
SMTP_FROM="noreply@tudominio.com"
POSTMARK_API_TOKEN=""

# Lemon Squeezy (Facturación y Suscripciones)
# Obtén estas credenciales en tu panel de https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY="tu_clave_api_de_lemonsqueezy"
LEMONSQUEEZY_STORE_ID="tu_id_de_tienda"
LEMONSQUEEZY_WEBHOOK_SECRET="tu_secreto_de_firma_de_webhook"
LEMONSQUEEZY_PRO_VARIANT_ID="id_de_la_variante_del_plan_pro"
